# Copy to .env and fill in. .env is gitignored — never commit real keys.

# From SideShift dashboard -> Settings -> Integrations. Required for
# `sync --method api` / the web dashboard's Sync button to pull real data
# instead of sample_data/.
SIDESHIFT_API_KEY=

# Optional: override where the local SQLite store lives.
# UGC_ANALYTICS_DB_PATH=data/ugc_analytics.db
